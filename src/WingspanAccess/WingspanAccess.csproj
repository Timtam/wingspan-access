<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>WingspanAccess</AssemblyName>
    <RootNamespace>WingspanAccess</RootNamespace>
    <BuildInfoNamespace>WingspanAccess</BuildInfoNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <!-- Location of the Wingspan installation with BepInEx (IL2CPP, x86). -->
    <WingspanDir Condition="'$(WingspanDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Wingspan</WingspanDir>
    <GameBepInExDir>$(WingspanDir)\BepInEx</GameBepInExDir>
    <PluginDeployDir>$(GameBepInExDir)\plugins\WingspanAccess</PluginDeployDir>
    <PrismDll>$(RepoRoot)third_party\prism\x86\prism.dll</PrismDll>

    <!-- References come from the game's BepInEx folder once BepInEx has run there (development).
         Without the game (CI) they come from the BepInEx download (tools\fetch-bepinex.ps1) and
         from the reference assemblies in lib\interop (tools\make-reference-assemblies.ps1). -->
    <UseGameReferences Condition="'$(UseGameReferences)' == '' And Exists('$(GameBepInExDir)\interop\ScriptAssembly.dll')">true</UseGameReferences>
    <BepInExCoreDir Condition="'$(UseGameReferences)' == 'true'">$(GameBepInExDir)\core</BepInExCoreDir>
    <BepInExCoreDir Condition="'$(UseGameReferences)' != 'true'">$(RepoRoot)third_party\bepinex\BepInEx\core</BepInExCoreDir>
    <InteropDir Condition="'$(UseGameReferences)' == 'true'">$(GameBepInExDir)\interop</InteropDir>
    <InteropDir Condition="'$(UseGameReferences)' != 'true'">$(RepoRoot)lib\interop</InteropDir>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" LogicalName="WingspanAccess.Localization.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(BepInExCoreDir)\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExCoreDir)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExCoreDir)\BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="$(BepInExCoreDir)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExCoreDir)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(BepInExCoreDir)\0Harmony.dll" Private="false" />
    <!-- Interop assemblies generated by BepInEx for this game (or their reference assemblies). -->
    <Reference Include="$(InteropDir)\*.dll" Private="false" />
  </ItemGroup>

  <Target Name="CheckReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(BepInExCoreDir)\BepInEx.Core.dll')"
           Text="BepInEx not found in $(BepInExCoreDir). Run tools\fetch-bepinex.ps1, or start the game once with BepInEx installed." />
    <Error Condition="!Exists('$(InteropDir)\ScriptAssembly.dll')"
           Text="Interop assemblies not found in $(InteropDir). Run tools\make-reference-assemblies.ps1 on a machine with the game." />
  </Target>

  <!-- dotnet build -p:DeployToGame=true copies the plugin and prism.dll into the game (game must be closed). -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <Error Condition="!Exists('$(PrismDll)')" Text="prism.dll (x86) not found at $(PrismDll). Run tools\build-prism-x86.cmd first." />
    <MakeDir Directories="$(PluginDeployDir)" />
    <Copy SourceFiles="$(TargetPath);$(PrismDll)" DestinationFolder="$(PluginDeployDir)" />
    <Message Importance="high" Text="Deployed to $(PluginDeployDir)" />
  </Target>

</Project>
