<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>WingspanAccess</AssemblyName>
    <RootNamespace>WingspanAccess</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Version>0.1.0</Version>

    <!-- Location of the Wingspan installation with BepInEx (IL2CPP, x86) already run once. -->
    <WingspanDir Condition="'$(WingspanDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Wingspan</WingspanDir>
    <BepInExDir>$(WingspanDir)\BepInEx</BepInExDir>
    <PluginDeployDir>$(BepInExDir)\plugins\WingspanAccess</PluginDeployDir>
    <PrismDll>$(MSBuildThisFileDirectory)..\..\third_party\prism\x86\prism.dll</PrismDll>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" LogicalName="WingspanAccess.Localization.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(BepInExDir)\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\0Harmony.dll" Private="false" />
    <!-- Interop assemblies generated by BepInEx on the first game start. -->
    <Reference Include="$(BepInExDir)\interop\*.dll" Private="false" />
  </ItemGroup>

  <!-- dotnet build -p:DeployToGame=true copies the plugin and prism.dll into the game (game must be closed). -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <Error Condition="!Exists('$(PrismDll)')" Text="prism.dll (x86) not found at $(PrismDll). Run tools\build-prism-x86.cmd first." />
    <MakeDir Directories="$(PluginDeployDir)" />
    <Copy SourceFiles="$(TargetPath);$(PrismDll)" DestinationFolder="$(PluginDeployDir)" />
    <Message Importance="high" Text="Deployed to $(PluginDeployDir)" />
  </Target>

</Project>
