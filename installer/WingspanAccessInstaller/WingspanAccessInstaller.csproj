<Project Sdk="Microsoft.NET.Sdk">

  <!-- A single EXE on .NET Framework 4.8 (part of Windows 10 and 11), with standard WinForms
       controls so screen readers can use it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>WingspanAccessInstaller</AssemblyName>
    <RootNamespace>WingspanAccessInstaller</RootNamespace>
    <BuildInfoNamespace>WingspanAccessInstaller</BuildInfoNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>Installs, updates and removes Wingspan Access</Description>
    <Product>Wingspan Access Installer</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the build work without the .NET Framework targeting pack installed (CI). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WingspanAccessInstaller.Tests" />
  </ItemGroup>

  <!-- The Static Forms key for problem reports. It comes from the environment variable
       WA_STATICFORMS_KEY: set by hand on a developer's computer, from the repository secret
       STATICFORMS_KEY in the release and CI workflows. It is never in a file of the repository: the
       build writes it, scrambled, into obj\...\ReportKey.g.cs (obj is ignored by git). Built
       without it, the installer has no report function (ReportKey.Available is false). -->
  <PropertyGroup>
    <StaticFormsKey>$(WA_STATICFORMS_KEY)</StaticFormsKey>
  </PropertyGroup>

  <UsingTask TaskName="WriteReportKey" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Key ParameterType="System.String" />
      <File ParameterType="System.String" Required="true" />
      <Namespace ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // Scrambled, so the key is not readable as plain text in the EXE (it is no secret from
        // someone who takes the EXE apart: a form key is made to be used by clients).
        byte[] key = Encoding.UTF8.GetBytes((Key ?? string.Empty).Trim());
        byte[] pad;
        using (SHA256 sha = SHA256.Create())
            pad = sha.ComputeHash(Encoding.UTF8.GetBytes("Wingspan Access problem reports"));
        string data = string.Join(", ", key.Select((b, i) => (b ^ pad[i % pad.Length]).ToString()));
        string text =
            "// Generated by WingspanAccessInstaller.csproj from WA_STATICFORMS_KEY. Never commit this file.\n" +
            "namespace " + Namespace + ";\n" +
            "internal static class ReportKeyData\n" +
            "{\n" +
            "    public static readonly byte[] Pad = { " + string.Join(", ", pad.Select(b => b.ToString())) + " };\n" +
            "    public static readonly byte[] Data = { " + data + " };\n" +
            "}\n";
        if (!System.IO.File.Exists(File) || System.IO.File.ReadAllText(File) != text)
            System.IO.File.WriteAllText(File, text);
        Log.LogMessage(MessageImportance.Normal, key.Length > 0 ? "Problem reports: form key built in" : "Problem reports: no form key (WA_STATICFORMS_KEY not set), reports are off");
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateReportKey" BeforeTargets="BeforeCompile;CoreCompile">
    <PropertyGroup>
      <ReportKeyFile>$(IntermediateOutputPath)ReportKey.g.cs</ReportKeyFile>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteReportKey Key="$(StaticFormsKey)" File="$(ReportKeyFile)" Namespace="$(RootNamespace)" />
    <ItemGroup>
      <Compile Include="$(ReportKeyFile)" />
      <FileWrites Include="$(ReportKeyFile)" />
    </ItemGroup>
  </Target>

</Project>
